
# Local Postgres started via Docker — see docs/backend/step-30-local-postgres-docker.md
DATABASE_URL="postgresql://postgres:devpassword@localhost:5432/talaan"

# A separate database for the browser tests (Playwright). Every test run
# empties it and refills it with demo data — see e2e/global-setup.ts.
E2E_DATABASE_URL="postgresql://postgres:devpassword@localhost:5432/talaan_test"

# Optional: pin the app's clock to the demo morning (the seed data's day),
# for screenshots or a demo of the sample data. Leave unset for the real
# clock. Never set this on a real server. See src/lib/clock.ts.
# DEMO_NOW="2026-06-19T09:15:00+08:00"

# Where student photo thumbnails are kept (Step 46.5): "local" (a folder,
# .data/photos, for development) or "s3" (any S3-compatible service;
# Cloudflare R2 in production). Leave unset for "local".
# PHOTO_STORAGE="local"
# Only for PHOTO_STORAGE="s3". For Cloudflare R2: the account's S3 endpoint,
# a private bucket, and an R2 API token's two keys (read and write, that
# bucket only).
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# S3_BUCKET="talaan-photos"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
