{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(npm run *)",
      "Bash(node scripts/progress.mjs)"
    ],
    "deny": [
      "Bash(git add)",
      "Bash(git add *)",
      "Bash(git commit)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git pull)",
      "Bash(git pull *)",
      "Bash(git fetch)",
      "Bash(git fetch *)",
      "Bash(git init)",
      "Bash(git init *)",
      "Bash(git remote)",
      "Bash(git remote *)",
      "Bash(git checkout)",
      "Bash(git checkout *)",
      "Bash(git switch)",
      "Bash(git switch *)",
      "Bash(git branch)",
      "Bash(git branch *)",
      "Bash(git merge)",
      "Bash(git merge *)",
      "Bash(git rebase)",
      "Bash(git rebase *)",
      "Bash(git reset)",
      "Bash(git reset *)",
      "Bash(git restore)",
      "Bash(git restore *)",
      "Bash(git stash)",
      "Bash(git stash *)",
      "Bash(git tag)",
      "Bash(git tag *)",
      "Bash(git clean)",
      "Bash(git clean *)",
      "Bash(git cherry-pick)",
      "Bash(git cherry-pick *)",
      "Bash(git revert)",
      "Bash(git revert *)",
      "Bash(gh)",
      "Bash(gh *)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Edit(./.env)",
      "Edit(./.env.local)"
    ]
  }
}
