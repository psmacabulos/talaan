generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum NotificationPreference {
  off
  time_in_only
  time_in_and_time_out
}

model School {
  id                     String                 @id @default(uuid())
  name                   String
  address                String?
  theme                  Json
  logoUrl                String?
  showDepedLogo          Boolean                @default(false)
  notificationPreference NotificationPreference @default(time_in_and_time_out)
  // The school's clock, "HH:MM". A tap after lateAfter is late; no tap by
  // absentFrom means absent.
  lateAfter              String                 @default("08:05")
  absentFrom             String                 @default("09:00")
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  staff              Staff[]
  students           Student[]
  cards              Card[]
  taps               Tap[]
  alerts             Alert[]
  parentStudentLinks ParentStudentLink[]
  notifications      Notification[]
  devices            Device[]
  linkAttempts       LinkAttempt[]
  linkBlocks         LinkBlock[]
}

enum Role {
  super_admin
  principal
  teacher
}

enum StaffStatus {
  active
  invited
}

model Staff {
  id                 String      @id @default(uuid())
  // Null only for a super admin, who isn't tied to one school.
  schoolId           String?
  school             School?     @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  role               Role
  firstName          String
  lastName           String
  // One account per email, stored in lower case, so sign-in finds exactly one person.
  email              String      @unique
  // Never the password itself: see src/lib/password.ts. Null until the
  // staff member sets one (Step 50.5).
  passwordHash       String?
  status             StaffStatus @default(invited)
  advisoryGradeLevel Int?
  advisorySection    String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  recordedTaps Tap[]
  // The parent links this staff member removed (Step 55.4).
  removedLinks LinkBlock[]

  @@index([schoolId])
}

model Student {
  id             String   @id @default(uuid())
  schoolId       String
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  firstName      String
  middleName     String?
  lastName       String
  // A calendar date with no time of day: Postgres's DATE type.
  birthDate      DateTime @db.Date
  lrn            String?
  gradeLevel     Int
  section        String
  guardianName   String
  guardianMobile String
  // Where the photo thumbnail is stored (Step 46.5), e.g.
  // "school-balanga/student-0001/k3x9q2ab.webp". A key, never a provider URL.
  photoKey       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  cards         Card[]
  taps          Tap[]
  parentLinks   ParentStudentLink[]
  notifications Notification[]
  linkBlocks    LinkBlock[]

  // Serves both "every student at a school" and the link-a-child lookup.
  @@index([schoolId, lrn])
}

enum CardStatus {
  active
  lost
  retired
}

model Card {
  id        String     @id @default(uuid())
  schoolId  String
  school    School     @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  studentId String
  student   Student    @relation(fields: [studentId], references: [id], onDelete: Restrict)
  // One physical card, one row, forever: a lost card keeps its serial.
  serial    String     @unique
  status    CardStatus @default(active)
  linkedAt  DateTime   @default(now())

  // At most one *active* card per student. Lost and retired cards don't count.
  @@unique([studentId], map: "Card_one_active_per_student", where: { status: "active" })
  @@index([studentId])
}

model Tap {
  // Made by the tapping device, not the server: a tap sent twice (a retry
  // after a dropped connection) has the same id, so it's only stored once.
  id           String    @id
  schoolId     String
  school       School    @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  // The gate that read it, or "manual" for a time in recorded by hand.
  stationId    String
  // Kept as a plain copy, not a link to Card: an unknown card has no row.
  // Null only for a time in recorded by hand for a student with no card
  // (Step 55); with a card, its serial is kept, so the gate's 2-minute
  // check also sees the recorded tap.
  cardSerial   String?
  // Who the card belonged to at the moment of the tap. Null for an unknown card.
  studentId    String?
  student      Student?  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  tappedAt     DateTime
  // Step 55: read at a gate, or recorded by hand by a staff member when a
  // student's card didn't work or they have none.
  source       TapSource @default(card)
  // Who recorded it by hand. Kept as null if that staff member is removed.
  recordedById String?
  recordedBy   Staff?    @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  alert        Alert?

  @@index([schoolId, tappedAt])
  @@index([studentId, tappedAt])
}

enum TapSource {
  card
  manual
}

enum AlertType {
  lost_card_tapped
}

model Alert {
  id           String    @id @default(uuid())
  schoolId     String
  school       School    @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  // @unique makes this one-to-one: a tap raises at most one alert.
  tapId        String    @unique
  tap          Tap       @relation(fields: [tapId], references: [id], onDelete: Restrict)
  type         AlertType
  createdAt    DateTime  @default(now())
  acknowledged Boolean   @default(false)

  @@index([schoolId])
}

// A parent belongs to no school (Step 53): each linked child carries its own,
// on ParentStudentLink, so one account covers children at any school.
model Parent {
  id           String              @id @default(uuid())
  firstName    String
  lastName     String
  mobile       String
  // One account per email. Signup already checks this and shows a friendly
  // message; the database guarantees it even if two signups race.
  email        String              @unique
  // Never the password itself: see src/lib/password.ts.
  passwordHash String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  links        ParentStudentLink[]
  tokens       ParentToken[]
  // Step 55.2's link notices: the ones for this parent, and the ones about them.
  noticesFor   Notification[]      @relation("NotificationRecipient")
  noticesAbout Notification[]      @relation("NotificationAbout")
  linkBlocks   LinkBlock[]
}

// The parent app's sign-in (Step 53.3): one row per signed-in phone. The
// token itself is shown once, at sign-in, and only its sha256 is kept.
model ParentToken {
  id         String     @id @default(uuid())
  parentId   String
  // Unlike every other relation here: a token means nothing without its
  // parent, so deleting a parent account takes its tokens with it.
  parent     Parent     @relation(fields: [parentId], references: [id], onDelete: Cascade)
  tokenHash  String     @unique
  // What the app says it is, e.g. "Pixel 7", so a parent can tell sessions apart later.
  label      String?
  // Moved forward at most once an hour, so opening the app keeps it alive.
  // A token unused for 30 days stops working and is cleared (Step 54.1).
  lastUsedAt DateTime   @default(now())
  revokedAt  DateTime?
  createdAt  DateTime   @default(now())
  pushToken  PushToken?

  @@index([parentId])
}

enum PushPlatform {
  ios
  android
}

// Where a signed-in phone receives pushes (Step 53.4): its Expo push token.
// Step 54 sends to these. No parentId: the parent is the sign-in's, so the
// two can never disagree.
model PushToken {
  id            String         @id @default(uuid())
  // The phone's address, as Expo gave it. One row per phone: a phone that
  // signs in as another parent moves its row to that sign-in.
  token         String         @unique
  platform      PushPlatform
  // One push address per signed-in phone. Deleted with its sign-in, which
  // is cleared after 30 days unused (Step 54.1): the parent opens the app,
  // or signs in again, to keep getting pushes.
  parentTokenId String         @unique
  parentToken   ParentToken    @relation(fields: [parentTokenId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deliveries    PushDelivery[]
}

enum PushDeliveryStatus {
  waiting
  sending
  sent
  failed
}

// One push to one phone (Step 54), made by the push worker from a
// notification. Deleted once Expo's receipt says it was delivered (Step
// 54.1); a failed one is kept 7 days.
model PushDelivery {
  id             String             @id @default(uuid())
  notificationId String
  notification   Notification       @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  // A phone that signs out, or that Expo says is gone, takes its pending pushes with it.
  pushTokenId    String
  pushToken      PushToken          @relation(fields: [pushTokenId], references: [id], onDelete: Cascade)
  status         PushDeliveryStatus @default(waiting)
  // Failed sends so far. A rate-limit answer doesn't count.
  tries          Int                @default(0)
  nextAttemptAt  DateTime           @default(now())
  // While "sending": if the worker died mid-send, the row is due again after this.
  claimedUntil   DateTime?
  // Expo's ticket, for Step 54.1's receipts.
  ticketId       String?
  // Expo's error code or a short reason, never the push token.
  lastError      String?
  createdAt      DateTime           @default(now())
  sentAt         DateTime?
  // When to ask Expo for this push's receipt (Step 54.1). Null: not sent
  // yet. A delivered push's row is deleted, so nothing about a success is kept.
  receiptDueAt   DateTime?

  @@unique([notificationId, pushTokenId])
  // Also the cleanup's: a failed row's nextAttemptAt is never earlier than its createdAt.
  @@index([status, nextAttemptAt])
  // Only the sent pushes still waiting for a receipt.
  @@index([receiptDueAt], map: "PushDelivery_receipt_due", where: raw("\"receiptDueAt\" IS NOT NULL"))
  // Postgres doesn't index a foreign key by itself: removing a phone would read every row.
  @@index([pushTokenId])
}

// One "link a child" try (Step 55.1), so a child's details can't be guessed
// one birth date at a time: 10 tries in 24 hours for one school, LRN and
// last name lock linking that child until a day has passed. Never the LRN
// itself: `keyHash` is an HMAC of the three with the server's secret. A
// successful link removes its own row; the rest are deleted after 24 hours.
model LinkAttempt {
  id        String   @id @default(uuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  keyHash   String
  createdAt DateTime @default(now())

  // "How many tries for this child in the last 24 hours?"
  @@index([keyHash, createdAt])
  // The cleanup of rows older than 24 hours.
  @@index([createdAt])
}

// A parent the school removed from a child (Step 55.4): they can't link that
// child again until the school allows it, which deletes this row. Who
// removed them, and when, is kept until then.
model LinkBlock {
  id               String   @id @default(uuid())
  schoolId         String
  school           School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  parentId         String
  // Goes with the parent's account if it's ever deleted (Step 60).
  parent           Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  studentId        String
  student          Student  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  removedAt        DateTime @default(now())
  // Empty once that staff member is removed: "by a former staff member".
  removedByStaffId String?
  removedBy        Staff?   @relation(fields: [removedByStaffId], references: [id], onDelete: SetNull)

  // One block per parent and child; also what linking looks up.
  @@unique([parentId, studentId])
  // The drawer's "Removed" list for the page's students.
  @@index([schoolId, studentId])
  // Postgres doesn't index a foreign key by itself: removing a staff member would read every row.
  @@index([removedByStaffId])
}

model ParentStudentLink {
  id        String   @id @default(uuid())
  // The child's school, saved when the parent's details matched a student
  // there (Step 53). Every parent read uses it, never a school from the browser.
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  parentId  String
  parent    Parent   @relation(fields: [parentId], references: [id], onDelete: Restrict)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  linkedAt  DateTime @default(now())

  // A parent links each child once. The link-a-child form already says
  // "already linked"; this makes it impossible, not just unlikely.
  @@unique([parentId, studentId])
  // The dashboard's "new links in the last 7 days" (Step 55.3); also any
  // lookup by school alone, which can use an index's first column.
  @@index([schoolId, linkedAt])
  @@index([studentId])
}

enum NotificationKind {
  time_in
  time_out
  // A parent linked this child (Step 55.2): one for each of the child's other guardians.
  guardian_linked
}

model Notification {
  id                String           @id @default(uuid())
  schoolId          String
  school            School           @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  studentId         String
  student           Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  kind              NotificationKind
  // When it happened: a copy of the tap's time, so the feed can say
  // "arrived 7:56 AM" without looking the tap up, or for guardian_linked
  // the link's time (Step 55.2).
  tappedAt          DateTime
  read              Boolean          @default(false)
  // Empty: every guardian of the child sees it and shares its read mark
  // (taps). Set: only this parent does (Step 55.2's link notices). Goes
  // with the parent's account if it's ever deleted.
  recipientParentId String?
  recipientParent   Parent?          @relation("NotificationRecipient", fields: [recipientParentId], references: [id], onDelete: Cascade)
  // guardian_linked only: the parent who linked, for their name. Emptied
  // if that account is ever deleted; the notice then says "A parent account".
  aboutParentId     String?
  aboutParent       Parent?          @relation("NotificationAbout", fields: [aboutParentId], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())
  // The outbox (Step 54): when the push worker made this notification's
  // deliveries, one per phone. Null means still to send. Written in the
  // same transaction as those deliveries, so a push is never lost between
  // the two.
  pushedAt          DateTime?
  deliveries        PushDelivery[]

  @@index([studentId, tappedAt])
  @@index([schoolId])
  // Only the few still to send, oldest first: the worker's one question.
  @@index([createdAt], map: "Notification_to_push", where: raw("\"pushedAt\" IS NULL"))
  // Postgres doesn't index a foreign key by itself. Link notices only, so both stay tiny.
  @@index([recipientParentId], map: "Notification_recipient", where: raw("\"recipientParentId\" IS NOT NULL"))
  @@index([aboutParentId], map: "Notification_about", where: raw("\"aboutParentId\" IS NOT NULL"))
}

enum DeviceKind {
  gate
  monitor
}

enum DeviceStatus {
  active
  revoked
}

model Device {
  id         String       @id @default(uuid())
  schoolId   String
  school     School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  // What staff call it: "Main gate tablet", "Guardhouse monitor".
  label      String
  kind       DeviceKind
  // sha256 of the token. The token itself is shown once and never stored.
  tokenHash  String       @unique
  status     DeviceStatus @default(active)
  // Set by every heartbeat. Null until the device first checks in.
  lastSeenAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([schoolId])
}
