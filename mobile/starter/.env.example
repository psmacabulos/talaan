# Copy to .env and fill in. Never commit .env.

# The Talaan server the app talks to (docs/SERVER.md): the live server by
# default. Fallback, Talaan on the owner's Mac on the same Wi-Fi as the phone:
# http://<the Mac's address>:3000 (find it with: ipconfig getifaddr en0).
EXPO_PUBLIC_API_URL="https://bantayaral.herokuapp.com"
