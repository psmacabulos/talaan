{
  "name": "talaan",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "format": "prettier --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test e2e/login.spec.ts e2e/students.spec.ts e2e/theme.spec.ts e2e/parent.spec.ts e2e/gate.spec.ts e2e/gate-monitor.spec.ts e2e/attendance.spec.ts e2e/isolation.spec.ts e2e/parent-api.spec.ts",
    "test:a11y": "npm run build && playwright test e2e/a11y.spec.ts",
    "check:tokens": "node scripts/check-tokens.mjs",
    "db:reset": "tsx prisma/reset-demo.ts",
    "device:create": "tsx scripts/create-device.ts",
    "staff:link": "tsx scripts/staff-link.ts",
    "tap:record": "tsx scripts/record-tap.ts",
    "progress": "node scripts/progress.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sentry/nextjs": "11.8.0",
    "aws4fetch": "^1.0.20",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.3",
    "culori": "^4.0.2",
    "dotenv": "^18.0.5",
    "lucide-react": "^1.52.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "nodemailer": "10.2.1",
    "prisma": "^7.10.0",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
    "sonner": "^2.0.8",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/culori": "^4.0.1",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
